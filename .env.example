# Explicitly load this file when adding environment-based settings.
# Initial API exposes only /health and /docs; integrations are not wired yet.
# Future credentials must stay outside Git and outside target/scorer sandboxes.

# CLI reads process environment; export explicitly (this file is not auto-loaded).
EVAL_RUNNER_MODE=docker
EVAL_DOCKER_NETWORK=none
EVAL_K8S_NAMESPACE=default
EVAL_RUNNER_STATE_DB=data/runner.db
EVAL_RUNNER_CLI_TIMEOUT=60

# Business execution: OpenShell gateway + Langfuse dataset/experiment.
# Export explicitly. Real secrets belong in a secret manager, not Git.
DATASET_ID=
EVALUATE_ID=
SCORER_IDS=["sc-risk"]
EVAL_PLATFORM=langfuse
EVAL_CONCURRENCY=1
EVAL_TARGET_URL=
EVAL_MODEL_ID=
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
EVAL_OPENSHELL_DOCKER_GATEWAY=
EVAL_OPENSHELL_K8S_GATEWAY=
EVAL_OPENSHELL_POLICY=
EVAL_WORKER_IMAGE=evaluation-worker:dev
EVAL_EXECUTION_TIMEOUT=600

# LLM proxy: container SDKs are redirected to a local OpenAI-compatible endpoint.
EVAL_LLM_PROXY_ENABLED=false
EVAL_MODEL_REGISTRY=data/models.json
EVAL_MODEL_RESOLVER_URL=http://host.docker.internal:8001
EVAL_MODEL_RESOLVER_TOKEN=
# EVAL_MODEL_ID is the backend registry key, e.g. glm-dev (not provider model name).
