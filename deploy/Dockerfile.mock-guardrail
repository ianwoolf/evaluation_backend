FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir 'fastapi>=0.115,<1' 'uvicorn>=0.30,<1' && useradd -u 10001 -m mockguard
COPY src/evaluation_backend/mock_guardrail.py /app/mock_guardrail.py
USER 10001
EXPOSE 8002
ENTRYPOINT ["python", "-m", "uvicorn", "mock_guardrail:app", "--host", "0.0.0.0", "--port", "8002", "--no-access-log"]
