# Non-secret application settings for the Docker Compose deployment.
# Maintained by deployment operators; consumed by the API and runner services.
# Keep passwords and tokens in Compose secrets, not in this file.
# Host ports, image tags, Docker network and socket GID belong in ../.env.

# API / UI users: access mode and default project
# "none" enables the standalone UI without login; "token" requires API authentication.
EVAL_AUTH_MODE=none
# Project used for standalone requests that do not specify a project.
EVAL_DEFAULT_PROJECT_ID=individual

# API / deployment operators: execution and temporary uploads
# Launch each evaluation as a Docker container rather than a Kubernetes Job.
EVAL_EXECUTION_BACKEND=docker
# API-side upload directory backed by the Compose uploads volume.
EVAL_UPLOAD_DIR=/uploads

# API / model operators: model registry
# Registry entries contain model endpoints and token_env references, not tokens.
# Targets, datasets, environments and target evaluation settings are stored in ES.
EVAL_MODEL_REGISTRY=/config/models.json

# API and collector / storage operators: Elasticsearch connection
EVAL_STORAGE_BACKEND=elasticsearch
# Internal Compose address, not the host-published Elasticsearch port.
EVAL_ES_URL=http://evaluation-es:9200
# Password or API key is loaded separately from Compose secrets.
EVAL_ES_USERNAME=elastic
# Applies to HTTPS connections only; set true to verify the server certificate.
EVAL_ES_VERIFY_SSL=false

# API and collector / storage operators: shared Elasticsearch indices
# Resources (including targets), evaluation configuration and run summaries.
EVAL_ES_RECORDS_INDEX=evaluation-records-v2
# Sample inputs/outputs and their embedded evaluation scores.
EVAL_ES_SAMPLES_INDEX=evaluation-samples-v2
# Execution traces and telemetry.
EVAL_ES_TRACES_INDEX=evaluation-traces-v1

# Runner / execution operators: internal API endpoints
# Runners use these Compose-network URLs to load data and resolve models.
# These addresses must be reachable from dynamically created runner containers.
EVAL_STORAGE_API_URL=http://evaluation-api:8001
EVAL_MODEL_RESOLVER_URL=http://evaluation-api:8001

# Runner and collector / observability operators: execution and result export
# Export collected traces and scores to Elasticsearch.
EVAL_COLLECTOR_EXPORTER=elasticsearch
# Enable the supervised model proxy when model invocation is required.
# Environments with modelId=none skip the model proxy and retain the collector.
EVAL_LLM_PROXY_ENABLED=true

# All services / support operators: logging
# Structured logs go to stdout; optional OTLP export is configured separately.
EVAL_LOG_LEVEL=INFO
