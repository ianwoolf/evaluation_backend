FROM python:3.12-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends git openssh-client curl ca-certificates jq procps iproute2 dnsutils netcat-openbsd \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN pip install --no-cache-dir . && useradd -u 10001 -m worker
USER worker
# Keep the default directory traversable when deployment helpers override --user.
WORKDIR /app
ENTRYPOINT ["python", "-m", "evaluation_backend.worker"]
